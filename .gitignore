logs/
*.log
*.log.*

# --- Scratch & Temporary Generated Files ---
/scratch/
/tmp/
/temp/

# --- Local Investigation Results & Reset Backups ---
# Retained locally for reference; not part of the current application.
/experiments/
/models/experiments/

# Current product provenance is part of the reproducible serving bundles.
# Keep model bundles, evaluation datasets, tests and research/protocol notes.
# Do not blanket-ignore models/, datasets/, docs/, report/ or Markdown/PDF files.

# --- Large Model Checkpoints & Binary Weights ---
# (Ignore generic heavy checkpoints, but explicitly track lightweight demo models)
*.h5
*.pt
*.pth
*.onnx
*.joblib
*.pkl

# Explicitly KEEP core pre-trained model & preprocessor required to run the demo app
!models/loan_prediction_model.pkl
!models/preprocessor.pkl
!models/feature_config.json
!models/model_metadata.json
!models/homeloan/model.pkl
!models/homeloan/preprocessor.pkl
!models/personalloan/model.pkl
!models/personalloan/preprocessor.pkl

# --- Large Temporary Datasets ---
*.parquet
*.feather
*.h5
*.sqlite3
*.sqlite
*.db
*.db-*
*.sqlite-*
*.sqlite3-*
!datasets/train.csv
!data/processed/train_clean.csv

# --- LaTeX Compilation Intermediates ---
# Keep .tex/.bib sources, diagram assets and the named final report PDF.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz
*.xdv
