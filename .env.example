# =============================================================================
# TrustFin AI - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' before running the application:
#   copy .env.example .env
# =============================================================================

# Database Connection URL
# -----------------------------------------------------------------------------
# Option A: Cloud Serverless PostgreSQL (e.g., Neon DB, Supabase, RDS)
# DATABASE_URL=postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Option B: Local SQLite (Zero-configuration local runs)
DATABASE_URL=sqlite:///./trustfin_local.db

# Backend Server Configuration
# -----------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1

# Frontend API URL (Used if modifying ports)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1/loan
